{
  "name": "uplift",
  "version": "0.1.0",
  "private": true,
  "description": "100% local first-person covert civilization simulation inspired by Iain M. Banks' Culture stories",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests vitest.config.ts",
    "lint:fix": "eslint --fix src tests vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:arch": "vitest run tests/architecture/",
    "test:unit": "vitest run tests/unit/",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:arch && npm run test:unit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
