{
  "name": "uplift",
  "version": "0.1.0",
  "private": true,
  "description": "100% local covert civilization simulation inspired by Iain M. Banks' Culture stories",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "logs:query": "node --import 'data:text/javascript,import{registerHooks}from\"node:module\";registerHooks({resolve(s,c,n){if(s.startsWith(\".\")&&s.endsWith(\".js\")){try{return n(s,c)}catch{return n(s.slice(0,-3)+\".ts\",c)}}return n(s,c)}})' src/interfaces/cli/queryLogs.ts",
    "format": "prettier --write . --cache --cache-location .prettiercache",
    "format:check": "prettier --check . --cache --cache-location .prettiercache",
    "lint": "eslint src tests vitest.config.ts vite.config.ts eslint.config.mjs scripts/verify.mjs --cache --cache-location .eslintcache",
    "lint:fix": "eslint --fix src tests vitest.config.ts vite.config.ts eslint.config.mjs scripts/verify.mjs --cache --cache-location .eslintcache",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:arch": "vitest run tests/architecture/",
    "test:unit": "vitest run tests/unit/",
    "verify": "node scripts/verify.mjs",
    "verify:serial": "npm run format:check && npm run lint && npm run typecheck && npm run test:arch && npm run test:unit"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
